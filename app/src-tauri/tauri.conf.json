{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomodairo",
  "version": "0.2.0",
  "identifier": "com.pomodairo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pomodairo",
        "width": 320,
        "height": 467,
        "minWidth": 320,
        "minHeight": 52,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb"
    ],
    "publisher": "Pomodairo contributors",
    "copyright": "Pomodairo contributors",
    "category": "Productivity",
    "shortDescription": "Pomodoro timer and task tracker",
    "longDescription": "A small, always-at-hand Pomodoro timer with a task list, interruption tracking and statistics.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "libasound2 | libasound2t64"
        ],
        "section": "utils"
      }
    }
  }
}
